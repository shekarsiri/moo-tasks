{
  "name": "moo-tasks",
  "version": "1.0.0",
  "description": "Robust, agentic task orchestration & management engine with MCP, Web UI, and human-in-the-loop controls",
  "type": "module",
  "bin": {
    "moo-tasks": "./dist/cli/index.js",
    "moo": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node scripts/build-ui.js",
    "build:backend": "tsc",
    "dev": "tsx src/cli/index.ts start",
    "dev:mcp": "tsx src/cli/index.ts mcp",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "agentic-workflow",
    "claude-code",
    "antigravity",
    "task-management",
    "human-in-the-loop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "fastify": "^4.28.1",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
